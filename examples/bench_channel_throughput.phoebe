fn producer(sender: Sender<I64>, count: I64) -> I64 {
  var index = 0;
  var rejected = 0;
  while (index < count) {
    when (sender.send(index)) {
      Send<I64>.Sent -> { 0 },
      Send<I64>.Closed(value) -> {
        rejected = rejected + 1;
        0
      }
    };
    index = index + 1;
  }
  sender.close();
  rejected
}

fn exchange() -> Result<I64, ResourceError> {
  val (sender, receiver) = channel<I64>(capacity = 1)?;
  spawn producer(sender, 10000)?;
  var index = 0;
  var total = 0;
  while (index < 10000) {
    when (receiver.receive()) {
      Receive<I64>.Value(value) -> {
        total = total + value;
        index = index + 1;
        0
      },
      Receive<I64>.End -> {
        index = 10000;
        0
      }
    };
  }
  receiver.close();
  Result<I64, ResourceError>.Ok(total)
}

fn main() -> I64 {
  when (exchange()) {
    Result<I64, ResourceError>.Ok(value) -> { value },
    Result<I64, ResourceError>.Err(error) -> { -1 }
  }
}
