fn close_nested(value: Option<Option<Sender<I64>>>) -> I64 {
  value.close_caps();
  42
}

fn acquire() -> Result<I64, ResourceError> {
  val (sender, receiver) = channel<I64>(capacity = 1)?;
  receiver.close();
  val nested = Option<Option<Sender<I64>>>.Some(Option<Sender<I64>>.Some(sender));
  Result<I64, ResourceError>.Ok(close_nested(nested))
}

fn value(result: Result<I64, ResourceError>) -> I64 = when (result) {
  Result<I64, ResourceError>.Ok(number) -> { number },
  Result<I64, ResourceError>.Err(error) -> { 0 },
}

fn main() -> I64 = value(acquire()) + close_nested(Option<Option<Sender<I64>>>.Some(Option<Sender<I64>>.None))
