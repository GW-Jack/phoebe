fn producer(sender: Sender<I64>) -> I64 {
  val sent = sender.send(1);
  sender.close();
  when (sent) {
    Send<I64>.Sent -> { 0 },
    Send<I64>.Closed(value) -> { value }
  }
}

fn add_after_wait(value: &mut I64, receiver: Receiver<I64>) -> I64 {
  val item = receiver.receive();
  receiver.close();
  value = value + when (item) {
    Receive<I64>.Value(amount) -> { amount },
    Receive<I64>.End -> { 0 }
  };
  value
}

fn exchange() -> Result<I64, ResourceError> {
  val (sender, receiver) = channel<I64>(capacity = 1)?;
  spawn producer(sender)?;
  var total = 41;
  with borrowed = &mut total {
    val updated = add_after_wait(&mut borrowed, receiver);
    borrowed = updated;
  };
  Result<I64, ResourceError>.Ok(total)
}

fn main() -> I64 {
  when (exchange()) {
    Result<I64, ResourceError>.Ok(value) -> { value },
    Result<I64, ResourceError>.Err(error) -> { 0 }
  }
}
