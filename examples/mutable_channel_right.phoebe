fn exercise() -> Result<I64, ResourceError> {
  var (active, first_receiver) = channel<I64>(capacity = 1)?;
  var (second, incoming) = channel<I64>(capacity = 1)?;
  val retired = active;
  retired.close();
  first_receiver.close();
  active = second;
  yield;
  val sent = active.send(42);
  active.close();
  val received = incoming.receive();
  incoming.close();
  when (received) {
    Receive<I64>.Value(value) -> { Result<I64, ResourceError>.Ok(value) },
    Receive<I64>.End -> { Result<I64, ResourceError>.Ok(0) }
  }
}

fn main() -> I64 {
  when (exercise()) {
    Result<I64, ResourceError>.Ok(value) -> { value },
    Result<I64, ResourceError>.Err(error) -> { 0 }
  }
}
