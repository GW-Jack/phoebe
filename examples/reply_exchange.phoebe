fn worker(right: ReplyTo<I64>) -> I64 {
  val completed = right.complete(42);
  when (completed) {
    Complete<I64>.Delivered -> { 0 },
    Complete<I64>.Closed(value) -> { value }
  }
}

fn exchange() -> Result<I64, ResourceError> {
  val (right, receiver) = reply<I64>()?;
  spawn worker(right)?;
  val answer = receiver.receive();
  when (answer) {
    Reply<I64>.Value(value) -> { Result<I64, ResourceError>.Ok(value) },
    Reply<I64>.End -> { Result<I64, ResourceError>.Ok(0) }
  }
}

fn main() -> I64 {
  when (exchange()) {
    Result<I64, ResourceError>.Ok(value) -> { value },
    Result<I64, ResourceError>.Err(error) -> { 0 }
  }
}
