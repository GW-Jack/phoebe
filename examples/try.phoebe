fn read(x: I64) -> Result<I64, I64> =
  if (x < 0) { Result<I64, I64>.Err(x) } else { Result<I64, I64>.Ok(x) }

fn plus_one(x: I64) -> Result<I64, I64> {
  val value = read(x)?;
  Result<I64, I64>.Ok(value + 1)
}

fn consume(result: Result<I64, I64>) -> I64 = when (result) {
  Result<I64, I64>.Ok(value) -> { value },
  Result<I64, I64>.Err(error) -> { error },
}

fn main() -> I64 = consume(plus_one(41)) + consume(plus_one(-1)) + 1
