data Pair { left: I64, positive: Bool }

fn wrap(value: I64) -> Result<Pair, I64> =
  Result<Pair, I64>.Ok(Pair(value, true))

fn producer(sender: Sender<I64>) -> I64 {
  val sent = sender.send(42);
  sender.close();
  when (sent) {
    Send<I64>.Sent -> { 0 },
    Send<I64>.Closed(unsent) -> { unsent }
  }
}

fn exchange() -> Result<I64, ResourceError> {
  val (sender, receiver) = channel<I64>(capacity = 1)?;
  spawn producer(sender)?;
  val item = receiver.receive();
  receiver.close();
  val value = when (item) {
    Receive<I64>.Value(number) -> { number },
    Receive<I64>.End -> { 0 }
  };
  val wide = wrap(value);
  val answer = when (wide) {
    Result<Pair, I64>.Ok(pair) -> {
      if (pair.positive) { pair.left } else { 0 }
    },
    Result<Pair, I64>.Err(error) -> { 0 }
  };
  Result<I64, ResourceError>.Ok(answer)
}

fn main() -> I64 {
  when (exchange()) {
    Result<I64, ResourceError>.Ok(value) -> { value },
    Result<I64, ResourceError>.Err(error) -> { 0 }
  }
}
